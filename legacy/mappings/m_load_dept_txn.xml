<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE POWERMART SYSTEM "powrmart.dtd">
<POWERMART CREATION_DATE="01/15/2026 02:11:07" REPOSITORY_VERSION="188.95">
<REPOSITORY NAME="REP_BANK_PROD" VERSION="188" CODEPAGE="UTF-8">
<FOLDER NAME="BANK_ETL" GROUP="" OWNER="etl_admin" SHARED="NOTSHARED">

<!--
  m_load_dept_txn — parameterized mapping that ingests ONE department feed,
  normalizes it, converts to base currency, filters reversals, looks up the
  customer, aggregates the daily amount and upserts FACT_DAILY_CUSTOMER.

  Reused by 5 sessions (CARDS, PAYMENTS, LOANS, DEPOSITS, WEALTH) via the
  mapping parameter $$DEPT.
-->
<MAPPING DESCRIPTION="Department feed -> FACT_DAILY_CUSTOMER (parameterized)" ISVALID="YES"
         NAME="m_load_dept_txn" OBJECTVERSION="1" VERSIONNUMBER="7">

  <TRANSFORMATION DESCRIPTION="" NAME="SQ_DEPT_TXN" OBJECTVERSION="1" REUSABLE="NO" TYPE="Source Qualifier" VERSIONNUMBER="1">
    <TRANSFORMFIELD DATATYPE="string" NAME="TXN_ID" PORTTYPE="INPUT/OUTPUT" PRECISION="18" SCALE="0"/>
    <TRANSFORMFIELD DATATYPE="string" NAME="ACCOUNT_NO" PORTTYPE="INPUT/OUTPUT" PRECISION="12" SCALE="0"/>
    <TRANSFORMFIELD DATATYPE="string" NAME="DEPT_CODE" PORTTYPE="INPUT/OUTPUT" PRECISION="12" SCALE="0"/>
    <TRANSFORMFIELD DATATYPE="string" NAME="PRODUCT" PORTTYPE="INPUT/OUTPUT" PRECISION="20" SCALE="0"/>
    <TRANSFORMFIELD DATATYPE="decimal" NAME="AMOUNT" PORTTYPE="INPUT/OUTPUT" PRECISION="15" SCALE="2"/>
    <TRANSFORMFIELD DATATYPE="string" NAME="CCY" PORTTYPE="INPUT/OUTPUT" PRECISION="3" SCALE="0"/>
    <TRANSFORMFIELD DATATYPE="date/time" NAME="TXN_DATE" PORTTYPE="INPUT/OUTPUT" PRECISION="29" SCALE="9"/>
    <TRANSFORMFIELD DATATYPE="string" NAME="STATUS" PORTTYPE="INPUT/OUTPUT" PRECISION="10" SCALE="0"/>
    <TABLEATTRIBUTE NAME="Sql Query" VALUE="SELECT TXN_ID, ACCOUNT_NO, DEPT_CODE, PRODUCT, AMOUNT, CCY, TXN_DATE, STATUS FROM DEPT_TXN WHERE DEPT_CODE = '$$DEPT'"/>
    <TABLEATTRIBUTE NAME="Source Filter" VALUE=""/>
  </TRANSFORMATION>

  <TRANSFORMATION DESCRIPTION="" NAME="LKP_CUSTOMER" OBJECTVERSION="1" REUSABLE="NO" TYPE="Lookup Procedure" VERSIONNUMBER="1">
    <TRANSFORMFIELD DATATYPE="string" NAME="ACCOUNT_NO" PORTTYPE="INPUT" PRECISION="12" SCALE="0"/>
    <TRANSFORMFIELD DATATYPE="string" NAME="CUSTOMER_ID" PORTTYPE="OUTPUT" PRECISION="18" SCALE="0"/>
    <TRANSFORMFIELD DATATYPE="string" NAME="SEGMENT" PORTTYPE="OUTPUT" PRECISION="10" SCALE="0"/>
    <TABLEATTRIBUTE NAME="Lookup table name" VALUE="CUSTOMER_DIM"/>
    <TABLEATTRIBUTE NAME="Lookup condition" VALUE="DEPT_TXN.ACCOUNT_NO = CUSTOMER_DIM.ACCOUNT_NO"/>
    <TABLEATTRIBUTE NAME="Lookup policy on multiple match" VALUE="Use First Value"/>
  </TRANSFORMATION>

  <TRANSFORMATION DESCRIPTION="" NAME="LKP_FX" OBJECTVERSION="1" REUSABLE="NO" TYPE="Lookup Procedure" VERSIONNUMBER="1">
    <TRANSFORMFIELD DATATYPE="string" NAME="CCY" PORTTYPE="INPUT" PRECISION="3" SCALE="0"/>
    <TRANSFORMFIELD DATATYPE="decimal" NAME="FX_RATE" PORTTYPE="OUTPUT" PRECISION="15" SCALE="6"/>
    <TABLEATTRIBUTE NAME="Lookup table name" VALUE="FX_RATES"/>
    <TABLEATTRIBUTE NAME="Lookup condition" VALUE="DEPT_TXN.CCY = FX_RATES.CCY"/>
  </TRANSFORMATION>

  <TRANSFORMATION DESCRIPTION="" NAME="EXP_NORMALIZE" OBJECTVERSION="1" REUSABLE="NO" TYPE="Expression" VERSIONNUMBER="1">
    <TRANSFORMFIELD DATATYPE="string" NAME="DEPT" PORTTYPE="OUTPUT" EXPRESSION="UPPER(DEPT_CODE)" PRECISION="12" SCALE="0"/>
    <TRANSFORMFIELD DATATYPE="decimal" NAME="AMOUNT_BASE" PORTTYPE="OUTPUT" EXPRESSION="ROUND(AMOUNT * FX_RATE, 2)" PRECISION="18" SCALE="2"/>
    <TRANSFORMFIELD DATATYPE="string" NAME="IS_REV" PORTTYPE="OUTPUT" EXPRESSION="IIF(STATUS = 'REVERSAL', 'Y', 'N')" PRECISION="1" SCALE="0"/>
  </TRANSFORMATION>

  <TRANSFORMATION DESCRIPTION="" NAME="FILT_ACTIVE" OBJECTVERSION="1" REUSABLE="NO" TYPE="Filter" VERSIONNUMBER="1">
    <TABLEATTRIBUTE NAME="Filter Condition" VALUE="IS_REV = 'N' AND AMOUNT_BASE &lt;&gt; 0"/>
  </TRANSFORMATION>

  <TRANSFORMATION DESCRIPTION="" NAME="AGG_DAILY" OBJECTVERSION="1" REUSABLE="NO" TYPE="Aggregator" VERSIONNUMBER="1">
    <TRANSFORMFIELD DATATYPE="string" NAME="CUSTOMER_ID" PORTTYPE="GROUP BY" PRECISION="18" SCALE="0"/>
    <TRANSFORMFIELD DATATYPE="string" NAME="SEGMENT" PORTTYPE="GROUP BY" PRECISION="10" SCALE="0"/>
    <TRANSFORMFIELD DATATYPE="string" NAME="DEPT" PORTTYPE="GROUP BY" PRECISION="12" SCALE="0"/>
    <TRANSFORMFIELD DATATYPE="date/time" NAME="TXN_DATE" PORTTYPE="GROUP BY" PRECISION="29" SCALE="9"/>
    <TRANSFORMFIELD DATATYPE="decimal" NAME="AMOUNT_BASE" PORTTYPE="OUTPUT" EXPRESSION="SUM(AMOUNT_BASE)" PRECISION="18" SCALE="2"/>
  </TRANSFORMATION>

  <TRANSFORMATION DESCRIPTION="" NAME="SEQ_TXN_KEY" OBJECTVERSION="1" REUSABLE="NO" TYPE="Sequence Generator" VERSIONNUMBER="1">
    <TRANSFORMFIELD DATATYPE="integer" NAME="TXN_KEY" PORTTYPE="OUTPUT" PRECISION="18" SCALE="0"/>
    <TABLEATTRIBUTE NAME="Start Value" VALUE="1"/>
    <TABLEATTRIBUTE NAME="Increment By" VALUE="1"/>
    <TABLEATTRIBUTE NAME="Cycle" VALUE="NO"/>
  </TRANSFORMATION>

  <TRANSFORMATION DESCRIPTION="" NAME="UPD_STRAT" OBJECTVERSION="1" REUSABLE="NO" TYPE="Update Strategy" VERSIONNUMBER="1">
    <TABLEATTRIBUTE NAME="Update Strategy Expression" VALUE="DD_UPDATE"/>
    <TABLEATTRIBUTE NAME="Forward Rejected Rows" VALUE="YES"/>
  </TRANSFORMATION>

  <!-- ============================ CONNECTORS ============================ -->
  <CONNECTOR FROMFIELD="TXN_ID" FROMINSTANCE="SQ_DEPT_TXN" TOFIELD="TXN_ID" TOINSTANCE="LKP_CUSTOMER"/>
  <CONNECTOR FROMFIELD="ACCOUNT_NO" FROMINSTANCE="SQ_DEPT_TXN" TOFIELD="ACCOUNT_NO" TOINSTANCE="LKP_CUSTOMER"/>
  <CONNECTOR FROMFIELD="DEPT_CODE" FROMINSTANCE="SQ_DEPT_TXN" TOFIELD="DEPT_CODE" TOINSTANCE="LKP_CUSTOMER"/>
  <CONNECTOR FROMFIELD="AMOUNT" FROMINSTANCE="SQ_DEPT_TXN" TOFIELD="AMOUNT" TOINSTANCE="LKP_CUSTOMER"/>
  <CONNECTOR FROMFIELD="CCY" FROMINSTANCE="SQ_DEPT_TXN" TOFIELD="CCY" TOINSTANCE="LKP_CUSTOMER"/>
  <CONNECTOR FROMFIELD="STATUS" FROMINSTANCE="SQ_DEPT_TXN" TOFIELD="STATUS" TOINSTANCE="LKP_CUSTOMER"/>
  <CONNECTOR FROMFIELD="CCY" FROMINSTANCE="SQ_DEPT_TXN" TOFIELD="CCY" TOINSTANCE="LKP_FX"/>
  <CONNECTOR FROMFIELD="DEPT_CODE" FROMINSTANCE="SQ_DEPT_TXN" TOFIELD="DEPT_CODE" TOINSTANCE="EXP_NORMALIZE"/>
  <CONNECTOR FROMFIELD="AMOUNT" FROMINSTANCE="SQ_DEPT_TXN" TOFIELD="AMOUNT" TOINSTANCE="EXP_NORMALIZE"/>
  <CONNECTOR FROMFIELD="STATUS" FROMINSTANCE="SQ_DEPT_TXN" TOFIELD="STATUS" TOINSTANCE="EXP_NORMALIZE"/>
  <CONNECTOR FROMFIELD="FX_RATE" FROMINSTANCE="LKP_FX" TOFIELD="FX_RATE" TOINSTANCE="EXP_NORMALIZE"/>
  <CONNECTOR FROMFIELD="CUSTOMER_ID" FROMINSTANCE="LKP_CUSTOMER" TOFIELD="CUSTOMER_ID" TOINSTANCE="EXP_NORMALIZE"/>
  <CONNECTOR FROMFIELD="SEGMENT" FROMINSTANCE="LKP_CUSTOMER" TOFIELD="SEGMENT" TOINSTANCE="EXP_NORMALIZE"/>
  <CONNECTOR FROMFIELD="TXN_DATE" FROMINSTANCE="SQ_DEPT_TXN" TOFIELD="TXN_DATE" TOINSTANCE="EXP_NORMALIZE"/>
  <CONNECTOR FROMFIELD="DEPT" FROMINSTANCE="EXP_NORMALIZE" TOFIELD="DEPT" TOINSTANCE="FILT_ACTIVE"/>
  <CONNECTOR FROMFIELD="AMOUNT_BASE" FROMINSTANCE="EXP_NORMALIZE" TOFIELD="AMOUNT_BASE" TOINSTANCE="FILT_ACTIVE"/>
  <CONNECTOR FROMFIELD="IS_REV" FROMINSTANCE="EXP_NORMALIZE" TOFIELD="IS_REV" TOINSTANCE="FILT_ACTIVE"/>
  <CONNECTOR FROMFIELD="CUSTOMER_ID" FROMINSTANCE="EXP_NORMALIZE" TOFIELD="CUSTOMER_ID" TOINSTANCE="FILT_ACTIVE"/>
  <CONNECTOR FROMFIELD="SEGMENT" FROMINSTANCE="EXP_NORMALIZE" TOFIELD="SEGMENT" TOINSTANCE="FILT_ACTIVE"/>
  <CONNECTOR FROMFIELD="TXN_DATE" FROMINSTANCE="EXP_NORMALIZE" TOFIELD="TXN_DATE" TOINSTANCE="FILT_ACTIVE"/>
  <CONNECTOR FROMFIELD="CUSTOMER_ID" FROMINSTANCE="FILT_ACTIVE" TOFIELD="CUSTOMER_ID" TOINSTANCE="AGG_DAILY"/>
  <CONNECTOR FROMFIELD="SEGMENT" FROMINSTANCE="FILT_ACTIVE" TOFIELD="SEGMENT" TOINSTANCE="AGG_DAILY"/>
  <CONNECTOR FROMFIELD="DEPT" FROMINSTANCE="FILT_ACTIVE" TOFIELD="DEPT" TOINSTANCE="AGG_DAILY"/>
  <CONNECTOR FROMFIELD="TXN_DATE" FROMINSTANCE="FILT_ACTIVE" TOFIELD="TXN_DATE" TOINSTANCE="AGG_DAILY"/>
  <CONNECTOR FROMFIELD="AMOUNT_BASE" FROMINSTANCE="FILT_ACTIVE" TOFIELD="AMOUNT_BASE" TOINSTANCE="AGG_DAILY"/>
  <CONNECTOR FROMFIELD="CUSTOMER_ID" FROMINSTANCE="AGG_DAILY" TOFIELD="CUSTOMER_ID" TOINSTANCE="SEQ_TXN_KEY"/>
  <CONNECTOR FROMFIELD="SEGMENT" FROMINSTANCE="AGG_DAILY" TOFIELD="SEGMENT" TOINSTANCE="SEQ_TXN_KEY"/>
  <CONNECTOR FROMFIELD="DEPT" FROMINSTANCE="AGG_DAILY" TOFIELD="DEPT" TOINSTANCE="SEQ_TXN_KEY"/>
  <CONNECTOR FROMFIELD="TXN_DATE" FROMINSTANCE="AGG_DAILY" TOFIELD="TXN_DATE" TOINSTANCE="SEQ_TXN_KEY"/>
  <CONNECTOR FROMFIELD="AMOUNT_BASE" FROMINSTANCE="AGG_DAILY" TOFIELD="AMOUNT_BASE" TOINSTANCE="SEQ_TXN_KEY"/>
  <CONNECTOR FROMFIELD="TXN_KEY" FROMINSTANCE="SEQ_TXN_KEY" TOFIELD="TXN_KEY" TOINSTANCE="UPD_STRAT"/>
  <CONNECTOR FROMFIELD="CUSTOMER_ID" FROMINSTANCE="SEQ_TXN_KEY" TOFIELD="CUSTOMER_ID" TOINSTANCE="UPD_STRAT"/>
  <CONNECTOR FROMFIELD="SEGMENT" FROMINSTANCE="SEQ_TXN_KEY" TOFIELD="SEGMENT" TOINSTANCE="UPD_STRAT"/>
  <CONNECTOR FROMFIELD="DEPT" FROMINSTANCE="SEQ_TXN_KEY" TOFIELD="DEPT" TOINSTANCE="UPD_STRAT"/>
  <CONNECTOR FROMFIELD="TXN_DATE" FROMINSTANCE="SEQ_TXN_KEY" TOFIELD="TXN_DATE" TOINSTANCE="UPD_STRAT"/>
  <CONNECTOR FROMFIELD="AMOUNT_BASE" FROMINSTANCE="SEQ_TXN_KEY" TOFIELD="AMOUNT_BASE" TOINSTANCE="UPD_STRAT"/>
</MAPPING>

</FOLDER>
</REPOSITORY>
</POWERMART>
