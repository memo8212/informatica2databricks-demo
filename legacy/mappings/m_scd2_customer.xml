<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE POWERMART SYSTEM "powrmart.dtd">
<POWERMART CREATION_DATE="01/15/2026 02:11:07" REPOSITORY_VERSION="188.95">
<REPOSITORY NAME="REP_BANK_PROD" VERSION="188" CODEPAGE="UTF-8">
<FOLDER NAME="BANK_ETL" GROUP="" OWNER="etl_admin" SHARED="NOTSHARED">

<!--
  m_scd2_customer — Type-2 slowly changing dimension for CUSTOMER_DIM.
  A Lookup against the current dimension row detects changes; the Update
  Strategy upserts: close the old row (DD_UPDATE) and insert the new version
  (DD_INSERT). Migrated to a Delta MERGE with Change Data Feed.
-->
<MAPPING DESCRIPTION="SCD2 on customer segment" ISVALID="YES"
         NAME="m_scd2_customer" OBJECTVERSION="1" VERSIONNUMBER="5">

  <TRANSFORMATION NAME="SQ_CUST" TYPE="Source Qualifier" REUSABLE="NO">
    <TRANSFORMFIELD DATATYPE="string" NAME="ACCOUNT_NO" PORTTYPE="INPUT/OUTPUT" PRECISION="12"/>
    <TRANSFORMFIELD DATATYPE="string" NAME="CUSTOMER_ID" PORTTYPE="INPUT/OUTPUT" PRECISION="18"/>
    <TRANSFORMFIELD DATATYPE="string" NAME="SEGMENT" PORTTYPE="INPUT/OUTPUT" PRECISION="10"/>
    <TABLEATTRIBUTE NAME="Sql Query" VALUE="SELECT ACCOUNT_NO, CUSTOMER_ID, SEGMENT FROM CUSTOMER_DIM"/>
  </TRANSFORMATION>

  <TRANSFORMATION NAME="LKP_CURRENT" TYPE="Lookup Procedure" REUSABLE="NO">
    <TRANSFORMFIELD DATATYPE="string" NAME="ACCOUNT_NO" PORTTYPE="INPUT" PRECISION="12"/>
    <TRANSFORMFIELD DATATYPE="string" NAME="OLD_SEGMENT" PORTTYPE="OUTPUT" PRECISION="10"/>
    <TRANSFORMFIELD DATATYPE="string" NAME="CURR_FLAG" PORTTYPE="OUTPUT" PRECISION="1"/>
    <TABLEATTRIBUTE NAME="Lookup table name" VALUE="DIM_CUSTOMER"/>
    <TABLEATTRIBUTE NAME="Lookup condition" VALUE="CUSTOMER_DIM.ACCOUNT_NO = DIM_CUSTOMER.ACCOUNT_NO AND DIM_CUSTOMER.CURR_FLAG = 'Y'"/>
  </TRANSFORMATION>

  <TRANSFORMATION NAME="EXP_SCD2" TYPE="Expression" REUSABLE="NO">
    <TRANSFORMFIELD DATATYPE="string" NAME="IS_CHANGED" PORTTYPE="OUTPUT" EXPRESSION="IIF(SEGMENT &lt;&gt; OLD_SEGMENT, 'Y', 'N')" PRECISION="1"/>
    <TRANSFORMFIELD DATATYPE="date/time" NAME="EFFECTIVE_FROM" PORTTYPE="OUTPUT" EXPRESSION="SYSDATE()" PRECISION="29" SCALE="9"/>
  </TRANSFORMATION>

  <TRANSFORMATION NAME="UPD_STRAT" TYPE="Update Strategy" REUSABLE="NO">
    <TABLEATTRIBUTE NAME="Update Strategy Expression" VALUE="IIF(IS_CHANGED = 'Y', DD_UPDATE, DD_INSERT)"/>
  </TRANSFORMATION>

  <CONNECTOR FROMFIELD="ACCOUNT_NO" FROMINSTANCE="SQ_CUST" TOFIELD="ACCOUNT_NO" TOINSTANCE="LKP_CURRENT"/>
  <CONNECTOR FROMFIELD="SEGMENT" FROMINSTANCE="SQ_CUST" TOFIELD="SEGMENT" TOINSTANCE="EXP_SCD2"/>
  <CONNECTOR FROMFIELD="OLD_SEGMENT" FROMINSTANCE="LKP_CURRENT" TOFIELD="OLD_SEGMENT" TOINSTANCE="EXP_SCD2"/>
  <CONNECTOR FROMFIELD="IS_CHANGED" FROMINSTANCE="EXP_SCD2" TOFIELD="IS_CHANGED" TOINSTANCE="UPD_STRAT"/>
  <CONNECTOR FROMFIELD="EFFECTIVE_FROM" FROMINSTANCE="EXP_SCD2" TOFIELD="EFFECTIVE_FROM" TOINSTANCE="UPD_STRAT"/>
</MAPPING>

</FOLDER>
</REPOSITORY>
</POWERMART>
