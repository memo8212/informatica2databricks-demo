<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE POWERMART SYSTEM "powrmart.dtd">
<POWERMART CREATION_DATE="01/15/2026 02:11:07" REPOSITORY_VERSION="188.95">
<REPOSITORY NAME="REP_BANK_PROD" VERSION="188" CODEPAGE="UTF-8">
<FOLDER NAME="BANK_ETL" GROUP="" OWNER="etl_admin" SHARED="NOTSHARED">

<!--
  m_customer_360 — showcase mapping exercising the wider transformation set:
  two sources, Expression, Sorter, Rank, Router, Joiner, Normalizer, Union,
  SQL transformation and Aggregator.
-->
<MAPPING DESCRIPTION="Customer 360 (multi-source, router, union, normalizer)" ISVALID="YES"
         NAME="m_customer_360" OBJECTVERSION="1" VERSIONNUMBER="3">

  <TRANSFORMATION NAME="SQ_TXN" TYPE="Source Qualifier" REUSABLE="NO">
    <TRANSFORMFIELD DATATYPE="string" NAME="ACCOUNT_NO" PORTTYPE="INPUT/OUTPUT" PRECISION="12"/>
    <TRANSFORMFIELD DATATYPE="decimal" NAME="AMOUNT" PORTTYPE="INPUT/OUTPUT" PRECISION="15" SCALE="2"/>
    <TRANSFORMFIELD DATATYPE="string" NAME="DEPT_CODE" PORTTYPE="INPUT/OUTPUT" PRECISION="12"/>
    <TABLEATTRIBUTE NAME="Sql Query" VALUE="SELECT ACCOUNT_NO, AMOUNT, DEPT_CODE FROM DEPT_TXN"/>
  </TRANSFORMATION>

  <TRANSFORMATION NAME="EXP_TXN" TYPE="Expression" REUSABLE="NO">
    <TRANSFORMFIELD DATATYPE="decimal" NAME="AMOUNT_BASE" PORTTYPE="OUTPUT" EXPRESSION="ROUND(AMOUNT, 2)" PRECISION="18" SCALE="2"/>
    <TRANSFORMFIELD DATATYPE="string" NAME="BAND" PORTTYPE="OUTPUT" EXPRESSION="IIF(AMOUNT &gt; 1000, 'HIGH', 'LOW')" PRECISION="4"/>
  </TRANSFORMATION>

  <TRANSFORMATION NAME="SRT_TXN" TYPE="Sorter" REUSABLE="NO">
    <TABLEATTRIBUTE NAME="Sort Key" VALUE="ACCOUNT_NO ASC"/>
  </TRANSFORMATION>

  <TRANSFORMATION NAME="RNK_TXN" TYPE="Rank" REUSABLE="NO">
    <TRANSFORMFIELD DATATYPE="decimal" NAME="AMOUNT_BASE" PORTTYPE="OUTPUT" EXPRESSION="RANK(AMOUNT_BASE)" PRECISION="18" SCALE="2"/>
    <TABLEATTRIBUTE NAME="Top/Bottom" VALUE="Top"/>
    <TABLEATTRIBUTE NAME="Number of Ranks" VALUE="3"/>
    <TABLEATTRIBUTE NAME="Rank Port" VALUE="AMOUNT_BASE"/>
  </TRANSFORMATION>

  <TRANSFORMATION NAME="RTR_TXN" TYPE="Router" REUSABLE="NO">
    <GROUP NAME="G_HIGH" ORDER="1">
      <GROUPATTRIBUTE NAME="Filter Condition" VALUE="BAND = 'HIGH'"/>
    </GROUP>
    <GROUP NAME="G_LOW" ORDER="2">
      <GROUPATTRIBUTE NAME="Filter Condition" VALUE="BAND = 'LOW'"/>
    </GROUP>
    <TRANSFORMFIELD DATATYPE="string" NAME="ACCOUNT_NO" PORTTYPE="OUTPUT" GROUP="G_HIGH"/>
    <TRANSFORMFIELD DATATYPE="string" NAME="ACCOUNT_NO" PORTTYPE="OUTPUT" GROUP="G_LOW"/>
  </TRANSFORMATION>

  <TRANSFORMATION NAME="SQ_CUST" TYPE="Source Qualifier" REUSABLE="NO">
    <TRANSFORMFIELD DATATYPE="string" NAME="ACCOUNT_NO" PORTTYPE="INPUT/OUTPUT" PRECISION="12"/>
    <TRANSFORMFIELD DATATYPE="string" NAME="CUSTOMER_ID" PORTTYPE="INPUT/OUTPUT" PRECISION="18"/>
    <TRANSFORMFIELD DATATYPE="string" NAME="SEGMENT" PORTTYPE="INPUT/OUTPUT" PRECISION="10"/>
    <TABLEATTRIBUTE NAME="Sql Query" VALUE="SELECT ACCOUNT_NO, CUSTOMER_ID, SEGMENT FROM CUSTOMER_DIM"/>
  </TRANSFORMATION>

  <TRANSFORMATION NAME="JNR" TYPE="Joiner" REUSABLE="NO">
    <TRANSFORMFIELD DATATYPE="string" NAME="ACCOUNT_NO" PORTTYPE="INPUT/OUTPUT" PRECISION="12"/>
    <TRANSFORMFIELD DATATYPE="string" NAME="CUSTOMER_ID" PORTTYPE="OUTPUT" PRECISION="18"/>
    <TRANSFORMFIELD DATATYPE="string" NAME="SEGMENT" PORTTYPE="OUTPUT" PRECISION="10"/>
    <TRANSFORMFIELD DATATYPE="decimal" NAME="AMOUNT_BASE" PORTTYPE="OUTPUT" PRECISION="18" SCALE="2"/>
    <TABLEATTRIBUTE NAME="Join Condition" VALUE="CUSTOMER_DIM.ACCOUNT_NO = DEPT_TXN.ACCOUNT_NO"/>
    <TABLEATTRIBUTE NAME="Join Type" VALUE="Master Outer"/>
  </TRANSFORMATION>

  <TRANSFORMATION NAME="NORM_TXN" TYPE="Normalizer" REUSABLE="NO">
    <TRANSFORMFIELD DATATYPE="string" NAME="ACCOUNT_NO" PORTTYPE="OUTPUT" PRECISION="12"/>
    <TRANSFORMFIELD DATATYPE="decimal" NAME="AMOUNT_BASE" PORTTYPE="OUTPUT" PRECISION="18" SCALE="2"/>
  </TRANSFORMATION>

  <TRANSFORMATION NAME="UNI_TXN" TYPE="Union" REUSABLE="NO">
    <TRANSFORMFIELD DATATYPE="string" NAME="ACCOUNT_NO" PORTTYPE="OUTPUT" PRECISION="12"/>
    <TRANSFORMFIELD DATATYPE="decimal" NAME="AMOUNT_BASE" PORTTYPE="OUTPUT" PRECISION="18" SCALE="2"/>
  </TRANSFORMATION>

  <TRANSFORMATION NAME="SQL_TXN" TYPE="SQL" REUSABLE="NO">
    <TRANSFORMFIELD DATATYPE="string" NAME="ACCOUNT_NO" PORTTYPE="OUTPUT" PRECISION="12"/>
    <TRANSFORMFIELD DATATYPE="decimal" NAME="AMOUNT_BASE" PORTTYPE="OUTPUT" PRECISION="18" SCALE="2"/>
    <TABLEATTRIBUTE NAME="Sql Query" VALUE="SELECT ACCOUNT_NO, AMOUNT_BASE FROM in_view WHERE AMOUNT_BASE IS NOT NULL"/>
  </TRANSFORMATION>

  <TRANSFORMATION NAME="AGG_C360" TYPE="Aggregator" REUSABLE="NO">
    <TRANSFORMFIELD DATATYPE="string" NAME="ACCOUNT_NO" PORTTYPE="GROUP BY" PRECISION="12"/>
    <TRANSFORMFIELD DATATYPE="decimal" NAME="AMOUNT_BASE" PORTTYPE="OUTPUT" EXPRESSION="SUM(AMOUNT_BASE)" PRECISION="18" SCALE="2"/>
  </TRANSFORMATION>

  <CONNECTOR FROMFIELD="ACCOUNT_NO" FROMINSTANCE="SQ_TXN" TOFIELD="ACCOUNT_NO" TOINSTANCE="EXP_TXN"/>
  <CONNECTOR FROMFIELD="AMOUNT" FROMINSTANCE="SQ_TXN" TOFIELD="AMOUNT" TOINSTANCE="EXP_TXN"/>
  <CONNECTOR FROMFIELD="ACCOUNT_NO" FROMINSTANCE="EXP_TXN" TOFIELD="ACCOUNT_NO" TOINSTANCE="SRT_TXN"/>
  <CONNECTOR FROMFIELD="AMOUNT_BASE" FROMINSTANCE="EXP_TXN" TOFIELD="AMOUNT_BASE" TOINSTANCE="SRT_TXN"/>
  <CONNECTOR FROMFIELD="AMOUNT_BASE" FROMINSTANCE="SRT_TXN" TOFIELD="AMOUNT_BASE" TOINSTANCE="RNK_TXN"/>
  <CONNECTOR FROMFIELD="ACCOUNT_NO" FROMINSTANCE="RNK_TXN" TOFIELD="ACCOUNT_NO" TOINSTANCE="RTR_TXN"/>
  <CONNECTOR FROMFIELD="ACCOUNT_NO" FROMINSTANCE="SQ_CUST" TOFIELD="ACCOUNT_NO" TOINSTANCE="JNR"/>
  <CONNECTOR FROMFIELD="ACCOUNT_NO" FROMINSTANCE="RTR_TXN" TOFIELD="ACCOUNT_NO" TOINSTANCE="JNR"/>
  <CONNECTOR FROMFIELD="ACCOUNT_NO" FROMINSTANCE="JNR" TOFIELD="ACCOUNT_NO" TOINSTANCE="NORM_TXN"/>
  <CONNECTOR FROMFIELD="AMOUNT_BASE" FROMINSTANCE="JNR" TOFIELD="AMOUNT_BASE" TOINSTANCE="NORM_TXN"/>
  <CONNECTOR FROMFIELD="ACCOUNT_NO" FROMINSTANCE="NORM_TXN" TOFIELD="ACCOUNT_NO" TOINSTANCE="UNI_TXN"/>
  <CONNECTOR FROMFIELD="ACCOUNT_NO" FROMINSTANCE="UNI_TXN" TOFIELD="ACCOUNT_NO" TOINSTANCE="SQL_TXN"/>
  <CONNECTOR FROMFIELD="ACCOUNT_NO" FROMINSTANCE="SQL_TXN" TOFIELD="ACCOUNT_NO" TOINSTANCE="AGG_C360"/>
  <CONNECTOR FROMFIELD="AMOUNT_BASE" FROMINSTANCE="SQL_TXN" TOFIELD="AMOUNT_BASE" TOINSTANCE="AGG_C360"/>
</MAPPING>

</FOLDER>
</REPOSITORY>
</POWERMART>
