<!DOCTYPE POWERMART SYSTEM "powrmart.dtd">
<POWERMART CREATION_DATE="01/15/2026 02:11:07" REPOSITORY_VERSION="188.95">
<REPOSITORY NAME="REP_BANK_PROD" VERSION="188" CODEPAGE="UTF-8">
<FOLDER NAME="BANK_ETL" GROUP="" OWNER="etl_admin" SHARED="NOTSHARED">

<!-- mplt_normalize_txn: reusable normalization + base-currency conversion -->
<MAPPLET DESCRIPTION="Normalize dept code, convert amount to base currency, flag reversals" ISVALID="YES" NAME="mplt_normalize_txn" OBJECTVERSION="1" VERSIONNUMBER="3">
  <TRANSFORMATION NAME="IN_TXN" TYPE="Input Transformation" REUSABLE="YES">
    <TRANSFORMFIELD DATATYPE="string" NAME="DEPT_CODE" PORTTYPE="OUTPUT" PRECISION="12"/>
    <TRANSFORMFIELD DATATYPE="decimal" NAME="AMOUNT" PORTTYPE="OUTPUT" PRECISION="15" SCALE="2"/>
    <TRANSFORMFIELD DATATYPE="decimal" NAME="FX_RATE" PORTTYPE="OUTPUT" PRECISION="15" SCALE="6"/>
    <TRANSFORMFIELD DATATYPE="string" NAME="STATUS" PORTTYPE="OUTPUT" PRECISION="10"/>
  </TRANSFORMATION>
  <TRANSFORMATION NAME="EXP_NORMALIZE" TYPE="Expression" REUSABLE="YES">
    <TRANSFORMFIELD DATATYPE="string" NAME="DEPT" PORTTYPE="OUTPUT" EXPRESSION="UPPER(DEPT_CODE)" PRECISION="12"/>
    <TRANSFORMFIELD DATATYPE="decimal" NAME="AMOUNT_BASE" PORTTYPE="OUTPUT" EXPRESSION="ROUND(AMOUNT * FX_RATE, 2)" PRECISION="18" SCALE="2"/>
    <TRANSFORMFIELD DATATYPE="string" NAME="IS_REV" PORTTYPE="OUTPUT" EXPRESSION="IIF(STATUS = 'REVERSAL', 'Y', 'N')" PRECISION="1"/>
  </TRANSFORMATION>
  <TRANSFORMATION NAME="OUT_TXN" TYPE="Output Transformation" REUSABLE="YES">
    <TRANSFORMFIELD DATATYPE="string" NAME="DEPT" PORTTYPE="INPUT" PRECISION="12"/>
    <TRANSFORMFIELD DATATYPE="decimal" NAME="AMOUNT_BASE" PORTTYPE="INPUT" PRECISION="18" SCALE="2"/>
    <TRANSFORMFIELD DATATYPE="string" NAME="IS_REV" PORTTYPE="INPUT" PRECISION="1"/>
  </TRANSFORMATION>
  <CONNECTOR FROMFIELD="DEPT_CODE" FROMINSTANCE="IN_TXN" TOFIELD="DEPT_CODE" TOINSTANCE="EXP_NORMALIZE"/>
  <CONNECTOR FROMFIELD="AMOUNT" FROMINSTANCE="IN_TXN" TOFIELD="AMOUNT" TOINSTANCE="EXP_NORMALIZE"/>
  <CONNECTOR FROMFIELD="FX_RATE" FROMINSTANCE="IN_TXN" TOFIELD="FX_RATE" TOINSTANCE="EXP_NORMALIZE"/>
  <CONNECTOR FROMFIELD="STATUS" FROMINSTANCE="IN_TXN" TOFIELD="STATUS" TOINSTANCE="EXP_NORMALIZE"/>
  <CONNECTOR FROMFIELD="DEPT" FROMINSTANCE="EXP_NORMALIZE" TOFIELD="DEPT" TOINSTANCE="OUT_TXN"/>
  <CONNECTOR FROMFIELD="AMOUNT_BASE" FROMINSTANCE="EXP_NORMALIZE" TOFIELD="AMOUNT_BASE" TOINSTANCE="OUT_TXN"/>
  <CONNECTOR FROMFIELD="IS_REV" FROMINSTANCE="EXP_NORMALIZE" TOFIELD="IS_REV" TOINSTANCE="OUT_TXN"/>
</MAPPLET>

<!-- wklt_dept_ingest: reusable worklet running one session per department feed -->
<WORKLET DESCRIPTION="Run the 5 department-feed sessions" ISVALID="YES" NAME="wklt_dept_ingest" OBJECTVERSION="1" VERSIONNUMBER="2">
  <TASK NAME="s_dept_cards"    TYPE="Session" REUSABLE="NO" VERSIONNUMBER="1" ISVALID="YES"/>
  <TASK NAME="s_dept_payments" TYPE="Session" REUSABLE="NO" VERSIONNUMBER="1" ISVALID="YES"/>
  <TASK NAME="s_dept_loans"    TYPE="Session" REUSABLE="NO" VERSIONNUMBER="1" ISVALID="YES"/>
  <TASK NAME="s_dept_deposits" TYPE="Session" REUSABLE="NO" VERSIONNUMBER="1" ISVALID="YES"/>
  <TASK NAME="s_dept_wealth"   TYPE="Session" REUSABLE="NO" VERSIONNUMBER="1" ISVALID="YES"/>
  <WORKFLOWLINK CONDITION="" FROMTASK="s_dept_cards"    TOTASK="s_dept_payments"/>
  <WORKFLOWLINK CONDITION="" FROMTASK="s_dept_payments" TOTASK="s_dept_loans"/>
  <WORKFLOWLINK CONDITION="" FROMTASK="s_dept_loans"    TOTASK="s_dept_deposits"/>
  <WORKFLOWLINK CONDITION="" FROMTASK="s_dept_deposits" TOTASK="s_dept_wealth"/>
</WORKLET>

</FOLDER>
</REPOSITORY>
</POWERMART>
